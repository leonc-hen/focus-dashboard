// ============================================================
// CIRCULAR TIMER PROGRESS
// ============================================================

void drawProgressRing(
  LGFX &display,
  int centerX,
  int centerY,
  int radius,
  float progress,
  uint16_t color
) {
  if (progress < 0.0f) {
    progress = 0.0f;
  }

  if (progress > 1.0f) {
    progress = 1.0f;
  }

  const float startAngle = -90.0f;
  const float endAngle =
    startAngle + (360.0f * progress);

  for (
    float angle = 0.0f;
    angle < 360.0f;
    angle += 2.0f
  ) {
    float radians =
      angle * 3.14159265f / 180.0f;

    int x1 =
      centerX +
      (int)(cos(radians) * radius);

    int y1 =
      centerY +
      (int)(sin(radians) * radius);

    display.drawPixel(
      x1,
      y1,
      COLOR_DARK_GRAY
    );
  }

  if (progress <= 0.0f) {
    return;
  }

  for (
    float angle = startAngle;
    angle <= endAngle;
    angle += 2.0f
  ) {
    float radians =
      angle * 3.14159265f / 180.0f;

    int x =
      centerX +
      (int)(cos(radians) * radius);

    int y =
      centerY +
      (int)(sin(radians) * radius);

    display.fillCircle(
      x,
      y,
      2,
      color
    );
  }
}

// ============================================================
// COUNT COMPLETED TASKS
// ============================================================

int getCompletedTaskCount() {

  int count = 0;

  for (int i = 0; i < NUM_TASKS; i++) {
    if (tasks[i].completed) {
      count++;
    }
  }

  return count;
}

// ============================================================
// SAVE TASK DATA
// ============================================================

void saveTaskData() {

  preferences.begin("study", false);

  for (int i = 0; i < NUM_TASKS; i++) {

    String durationKey =
      "dur" + String(i);

    String completedKey =
      "done" + String(i);

    preferences.putInt(
      durationKey.c_str(),
      tasks[i].durationIndex
    );

    preferences.putBool(
      completedKey.c_str(),
      tasks[i].completed
    );
  }

  preferences.putULong(
    "studyTime",
    totalStudyMinutes
  );

  preferences.end();

  Serial.println("Task data saved.");
}

// ============================================================
// LOAD TASK DATA
// ============================================================

void loadTaskData() {

  preferences.begin("study", true);

  for (int i = 0; i < NUM_TASKS; i++) {

    String durationKey =
      "dur" + String(i);

    String completedKey =
      "done" + String(i);

    tasks[i].durationIndex =
      preferences.getInt(
        durationKey.c_str(),
        tasks[i].durationIndex
      );

    tasks[i].completed =
      preferences.getBool(
        completedKey.c_str(),
        false
      );

    if (
      tasks[i].durationIndex < 0 ||
      tasks[i].durationIndex >= NUM_DURATIONS
    ) {
      tasks[i].durationIndex = 0;
    }
  }

  totalStudyMinutes =
    preferences.getULong(
      "studyTime",
      0
    );

  preferences.end();

  Serial.println("Task data loaded.");
}

// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);
  delay(200);

  buttonPrevious.begin();
  buttonNext.begin();
  buttonSelect.begin();
  buttonBack.begin();

  Wire.begin(17, 18);

  if (!rtc.begin()) {

    Serial.println("RTC NOT FOUND");

  } else {

    Serial.println("RTC CONNECTED");

    if (rtc.lostPower()) {

      Serial.println("RTC LOST POWER");

      rtc.adjust(
        DateTime(F(__DATE__), F(__TIME__))
      );
    }
  }

  display1.init();
  display1.setRotation(0);
  display1.fillScreen(COLOR_BACKGROUND);

  display2.init();
  display2.setRotation(0);
  display2.fillScreen(COLOR_BACKGROUND);

  display3.init();
  display3.setRotation(0);
  display3.fillScreen(COLOR_BACKGROUND);

  loadTaskData();

  updateTaskDuration();

  drawHome();

  Serial.println();
  Serial.println("==============================");
  Serial.println("STUDY HELPER READY");
  Serial.println("==============================");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  if (buttonPrevious.pressed()) {
    handlePrevious();
  }

  if (buttonNext.pressed()) {
    handleNext();
  }

  if (buttonSelect.pressed()) {
    handleSelect();
  }

  if (buttonBack.pressed()) {
    handleBack();
  }

  updateTimer();

  if (
    currentScreen == HOME &&
    millis() - lastClockDisplay >= 1000
  ) {
    lastClockDisplay = millis();
    updateHomeTime();
  }

  if (
    currentScreen == TIMER &&
    millis() - lastTimerDisplay >= 500
  ) {
    lastTimerDisplay = millis();
    updateTimerDisplay();
  }
}

// ============================================================
// BUTTON 1
// ============================================================

void handlePrevious() {

  switch (currentScreen) {

    case HOME:

      selectedTask--;

      if (selectedTask < 0) {
        selectedTask = NUM_TASKS - 1;
      }

      drawHome();

      break;

    case TASKS:

      selectedTask--;

      if (selectedTask < 0) {
        selectedTask = NUM_TASKS - 1;
      }

      selectedDuration =
        tasks[selectedTask].durationIndex;

      updateTaskDuration();

      drawTasks();

      break;

    case TIMER:

      if (!timerRunning) {
        changeDuration(-1);
      }

      break;
  }
}

// ============================================================
// BUTTON 2
// ============================================================

void handleNext() {

  switch (currentScreen) {

    case HOME:

      selectedTask++;

      if (selectedTask >= NUM_TASKS) {
        selectedTask = 0;
      }

      drawHome();

      break;

    case TASKS:

      selectedTask++;

      if (selectedTask >= NUM_TASKS) {
        selectedTask = 0;
      }

      selectedDuration =
        tasks[selectedTask].durationIndex;

      updateTaskDuration();

      drawTasks();

      break;

    case TIMER:

      if (!timerRunning) {
        changeDuration(1);
      }

      break;
  }
}

// ============================================================
// BUTTON 3
// ============================================================

void handleSelect() {

  switch (currentScreen) {

    case HOME:

      currentScreen = TASKS;

      drawTasks();

      break;

    case TASKS:

      activeTask = selectedTask;

      selectedDuration =
        tasks[activeTask].durationIndex;

      updateTaskDuration();

      timerRunning = false;

      currentScreen = TIMER;

      drawTimer();

      break;

    case TIMER:

      if (timerRunning) {

        updateTimer();

        timerRunning = false;

        Serial.println("TIMER PAUSED");

        drawTimer();

      } else {

        if (remainingSeconds == 0) {

          remainingSeconds =
            timerDurationSeconds;
        }

        timerStartingRemaining =
          remainingSeconds;

        timerStartMillis =
          millis();

        timerRunning = true;

        Serial.println("TIMER STARTED");

        drawTimer();
      }

      break;
  }
}

// ============================================================
// BUTTON 4
// ============================================================

void handleBack() {

  switch (currentScreen) {

    case HOME:

      break;

    case TASKS:

      currentScreen = HOME;

      drawHome();

      break;

    case TIMER:

      timerRunning = false;

      remainingSeconds =
        timerDurationSeconds;

      currentScreen = TASKS;

      drawTasks();

      break;
  }
}

// ============================================================
// CHANGE TIMER DURATION
// ============================================================

void changeDuration(int direction) {

  selectedDuration += direction;

  if (selectedDuration < 0) {
    selectedDuration =
      NUM_DURATIONS - 1;
  }

  if (selectedDuration >= NUM_DURATIONS) {
    selectedDuration = 0;
  }

  tasks[activeTask].durationIndex =
    selectedDuration;

  timerDurationSeconds =
    (unsigned long)
    durations[selectedDuration] * 60UL;

  remainingSeconds =
    timerDurationSeconds;

  saveTaskData();

  drawTimer();

  Serial.print("Duration changed to ");
  Serial.print(durations[selectedDuration]);
  Serial.println(" minutes");
}

// ============================================================
// UPDATE TASK DURATION
// ============================================================

void updateTaskDuration() {

  selectedDuration =
    tasks[selectedTask].durationIndex;

  timerDurationSeconds =
    (unsigned long)
    durations[selectedDuration] * 60UL;

  remainingSeconds =
    timerDurationSeconds;
}

// ============================================================
// UPDATE TIMER
// ============================================================

void updateTimer() {

  if (!timerRunning) {
    return;
  }

  unsigned long elapsedMillis =
    millis() - timerStartMillis;

  unsigned long elapsedSeconds =
    elapsedMillis / 1000UL;

  if (
    elapsedSeconds >=
    timerStartingRemaining
  ) {

    remainingSeconds = 0;

    timerRunning = false;

    tasks[activeTask].completed = true;

    totalStudyMinutes +=
      durations[selectedDuration];

    saveTaskData();

    Serial.println("TIMER FINISHED");
    Serial.println("TASK COMPLETED");

    drawTimer();

    return;
  }

  remainingSeconds =
    timerStartingRemaining -
    elapsedSeconds;
}

