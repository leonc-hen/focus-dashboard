    centerText(
      display1,
      "PAUSED / READY",
      185,
      1
    );
  }

  // ==========================================================
  // DISPLAY 2: CIRCULAR TIMER
  // ==========================================================

  display2.fillScreen(COLOR_BACKGROUND);

  display2.setTextColor(COLOR_CYAN);

  centerText(
    display2,
    "TIMER",
    15,
    2
  );

  float progress = 0.0f;

  if (timerDurationSeconds > 0) {

    progress =
      (float)remainingSeconds /
      (float)timerDurationSeconds;
  }

  uint16_t ringColor;

  if (timerRunning) {

    ringColor = COLOR_GREEN;

  } else if (remainingSeconds == 0) {

    ringColor = COLOR_RED;

  } else {

    ringColor = COLOR_ORANGE;
  }

  drawProgressRing(
    display2,
    120,
    125,
    91,
    progress,
    ringColor
  );

  updateTimerValue();

  // ==========================================================
  // DISPLAY 3: CONTROLS
  // ==========================================================

  updateTimerStatus();

  lastTimerDisplay = millis();
}

// ============================================================
// TIMER VALUE
// ============================================================

void updateTimerValue() {

  unsigned long minutes =
    remainingSeconds / 60UL;

  unsigned long seconds =
    remainingSeconds % 60UL;

  char timerText[10];

  sprintf(
    timerText,
    "%02lu:%02lu",
    minutes,
    seconds
  );

  display2.setTextColor(COLOR_WHITE);

  centerText(
    display2,
    timerText,
    100,
    4
  );

  char durationText[20];

  sprintf(
    durationText,
    "%d MIN",
    durations[selectedDuration]
  );

  display2.setTextColor(COLOR_GRAY);

  centerText(
    display2,
    durationText,
    150,
    1
  );
}

// ============================================================
// TIMER STATUS
// ============================================================

void updateTimerStatus() {

  display3.fillScreen(COLOR_BACKGROUND);

  display3.setTextColor(COLOR_CYAN);

  centerText(
    display3,
    "CONTROLS",
    20,
    2
  );

  drawDivider(
    display3,
    50,
    COLOR_CYAN
  );

  if (timerRunning) {

    display3.setTextColor(COLOR_GREEN);

    centerText(
      display3,
      "RUNNING",
      75,
      2
    );

    display3.setTextColor(COLOR_WHITE);

    centerText(
      display3,
      "3  PAUSE",
      115,
      1
    );

    display3.setTextColor(COLOR_GRAY);

    centerText(
      display3,
      "4  TASKS",
      165,
      1
    );

    return;
  }

  if (remainingSeconds == 0) {

    display3.setTextColor(COLOR_ORANGE);

    centerText(
      display3,
      "COMPLETE",
      75,
      2
    );

    display3.setTextColor(COLOR_WHITE);

    centerText(
      display3,
      "3  RESTART",
      115,
      1
    );

    display3.setTextColor(COLOR_GRAY);

    centerText(
      display3,
      "4  TASKS",
      165,
      1
    );

    return;
  }

  display3.setTextColor(COLOR_ORANGE);

  centerText(
    display3,
    "READY",
    65,
    2
  );

  display3.setTextColor(COLOR_WHITE);

  centerText(
    display3,
    "1  - DURATION",
    105,
    1
  );

  centerText(
    display3,
    "2  + DURATION",
    135,
    1
  );

  display3.setTextColor(COLOR_CYAN);

  centerText(
    display3,
    "3  START",
    165,
    1
  );

  display3.setTextColor(COLOR_GRAY);

  centerText(
    display3,
    "4  TASKS",
    195,
    1
  );
}

// ============================================================
// TIMER DISPLAY UPDATE
// ============================================================

void updateTimerDisplay() {

  updateTimer();

  updateTimerValue();

  updateTimerStatus();

  float progress = 0.0f;

  if (timerDurationSeconds > 0) {

    progress =
      (float)remainingSeconds /
      (float)timerDurationSeconds;
  }

  uint16_t ringColor;

  if (timerRunning) {

    ringColor = COLOR_GREEN;

  } else if (remainingSeconds == 0) {

    ringColor = COLOR_RED;

  } else {

    ringColor = COLOR_ORANGE;
  }

  drawProgressRing(
    display2,
    120,
    125,
    91,
    progress,
    ringColor
  );
}
