// ============================================================
// BUTTON DEBOUNCE
// ============================================================

const unsigned long DEBOUNCE_MS = 50;

class DebouncedButton {
private:
  int pin;
  bool stableState;
  bool lastReading;
  unsigned long lastChangeTime;

public:
  DebouncedButton(int gpio) {
    pin = gpio;
    stableState = HIGH;
    lastReading = HIGH;
    lastChangeTime = 0;
  }

  void begin() {
    pinMode(pin, INPUT_PULLUP);
    stableState = digitalRead(pin);
    lastReading = stableState;
    lastChangeTime = millis();
  }

  bool pressed() {
    bool reading = digitalRead(pin);

    if (reading != lastReading) {
      lastReading = reading;
      lastChangeTime = millis();
    }

    if (
      millis() - lastChangeTime >= DEBOUNCE_MS &&
      reading != stableState
    ) {
      stableState = reading;

      if (stableState == LOW) {
        return true;
      }
    }

    return false;
  }
};

