    170,
    1
  );
}


// ============================================================
// UPDATE HOME TIME
// ============================================================

void updateHomeTime() {

  DateTime now = rtc.now();


  display1.fillRect(
    0,
    85,
    240,
    60,
    TFT_BLACK
  );


  char timeText[9];

  sprintf(
    timeText,
    "%02d:%02d:%02d",
    now.hour(),
    now.minute(),
    now.second()
  );


  display1.setTextColor(TFT_WHITE);

  centerText(
    display1,
    timeText,
    95,
    3
  );
}


// ============================================================
// TASK SCREEN
// ============================================================

void drawTasks() {

  display1.fillScreen(TFT_BLACK);
  display2.fillScreen(TFT_BLACK);
  display3.fillScreen(TFT_BLACK);

  display1.setTextColor(TFT_WHITE);
  display2.setTextColor(TFT_WHITE);
  display3.setTextColor(TFT_WHITE);


  // ----------------------------------------------------------
  // DISPLAY 1
  // ----------------------------------------------------------

  centerText(
    display1,
    "TASKS",
    25,
    2
  );


  centerText(
    display1,
    tasks[selectedTask],
    85,
    3
  );


  char positionText[10];

  sprintf(
    positionText,
    "%d / %d",
    selectedTask + 1,
    NUM_TASKS
  );


  centerText(
    display1,
    positionText,
    145,
    2
  );


  centerText(
    display1,
    "SELECT",
    190,
    1
  );


  // ----------------------------------------------------------
  // DISPLAY 2
  // ----------------------------------------------------------

  centerText(
    display2,
    "AVAILABLE",
    30,
    2
  );


  for (int i = 0; i < NUM_TASKS; i++) {

    char line[30];


    if (i == selectedTask) {

      sprintf(
        line,
        "> %s",
        tasks[i]
      );

    } else {

      sprintf(
        line,
        "  %s",
        tasks[i]
      );
    }


    display2.setTextSize(2);

    int width =
      display2.textWidth(line);

    int x =
      (240 - width) / 2;


    display2.setCursor(
      x,
      75 + i * 45
    );

    display2.print(line);
  }


  // ----------------------------------------------------------
  // DISPLAY 3
  // ----------------------------------------------------------

  centerText(
    display3,
    "BUTTON 1",
    35,
    1
  );

  centerText(
    display3,
    "PREVIOUS",
    60,
    1
  );


  centerText(
    display3,
    "BUTTON 2",
    100,
    1
  );

  centerText(
    display3,
    "NEXT",
    125,
    1
  );


  centerText(
    display3,
    "BUTTON 3 = SELECT",
    175,
    1
  );


  centerText(
    display3,
    "BUTTON 4 = BACK",
    200,
    1
  );
}


// ============================================================
// TIMER SCREEN
// ============================================================

void drawTimer() {

  display1.fillScreen(TFT_BLACK);
  display2.fillScreen(TFT_BLACK);
  display3.fillScreen(TFT_BLACK);

  display1.setTextColor(TFT_WHITE);
  display2.setTextColor(TFT_WHITE);
  display3.setTextColor(TFT_WHITE);


  // ----------------------------------------------------------
  // DISPLAY 1
  // ----------------------------------------------------------

  centerText(
    display1,
    "STUDY TIMER",
    30,
    2
  );


  centerText(
    display1,
    tasks[activeTask],
    90,
    3
  );


  if (!timerRunning) {

    centerText(
      display1,
      "SET TIME",
      155,
      1
    );

  } else {

    centerText(
      display1,
      "RUNNING",
      155,
      1
    );
  }


  // ----------------------------------------------------------
  // DISPLAY 2
  // ----------------------------------------------------------

  updateTimerValue();


  // ----------------------------------------------------------
  // DISPLAY 3
  // ----------------------------------------------------------

  updateTimerStatus();


  lastTimerDisplay = millis();
}


// ============================================================
// TIMER VALUE
// ============================================================

void updateTimerValue() {

  unsigned long minutes =
    remainingSeconds / 60;

  unsigned long seconds =
    remainingSeconds % 60;


  char timerText[10];

  sprintf(
    timerText,
    "%02lu:%02lu",
    minutes,
    seconds
  );


  display2.fillScreen(TFT_BLACK);

  display2.setTextColor(TFT_WHITE);


  centerText(
    display2,
    timerText,
    75,
    4
  );


  // ----------------------------------------------------------
  // Selected duration
  // ----------------------------------------------------------

  char durationText[20];

  sprintf(
    durationText,
    "%d MIN",
    durations[selectedDuration]
  );


  centerText(
    display2,
    durationText,
    145,
    2
  );
}


// ============================================================
// TIMER STATUS
// ============================================================

void updateTimerStatus() {

  display3.fillScreen(TFT_BLACK);

  display3.setTextColor(TFT_WHITE);


  // ----------------------------------------------------------
  // TIMER RUNNING
  // ----------------------------------------------------------

  if (timerRunning) {

    centerText(
      display3,
      "RUNNING",
      45,
      2
    );


    centerText(
      display3,
      "SELECT",
      100,
      1
    );


    centerText(
      display3,
      "PAUSE / RESUME",
      125,
      1
    );


    centerText(
      display3,
      "BACK = RESET",
      175,
      1
    );


    return;
  }


  // ----------------------------------------------------------
  // TIMER FINISHED
  // ----------------------------------------------------------

  if (remainingSeconds == 0) {

    centerText(
      display3,
      "COMPLETE!",
      50,
      2
    );


    centerText(
      display3,
      "SELECT = RESTART",
      115,
      1
    );


    centerText(
      display3,
      "BACK = TASKS",
      170,
      1
    );


    return;
  }


  // ----------------------------------------------------------
  // TIMER READY / PAUSED
  // ----------------------------------------------------------

  centerText(
    display3,
    "READY",
    45,
    2
  );


  centerText(
    display3,
    "SELECT = START",
    105,
    1
  );


  centerText(
    display3,
    "1 / 2 = CHANGE",
    145,
    1
  );


  centerText(
    display3,
    "BACK = TASKS",
    185,
    1
  );
}


// ============================================================
// TIMER DISPLAY UPDATE
// ============================================================

void updateTimerDisplay() {

  updateTimer();

  updateTimerValue();

  updateTimerStatus();
}
