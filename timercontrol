    "TIME",
    35,
    2
  );


  char timeText[9];

  sprintf(
    timeText,
    "%02d:%02d:%02d",
    now.hour(),
    now.minute(),
    now.second()
  );


  centerText(
    display1,
    timeText,
    95,
    3
  );


  centerText(
    display1,
    "HOME",
    180,
    1
  );


  // ----------------------------------------------------------
  // DISPLAY 2
  // ----------------------------------------------------------

  display2.fillScreen(TFT_BLACK);

  display2.setTextColor(TFT_WHITE);

  centerText(
    display2,
    "NEXT TASK",
    35,
    2
  );


  centerText(
    display2,
    tasks[selectedTask],
    95,
    3
  );


  centerText(
    display2,
    "SELECT FOR TASKS",
    170,
    1
  );


  // ----------------------------------------------------------
  // DISPLAY 3
  // ----------------------------------------------------------

  display3.fillScreen(TFT_BLACK);

  display3.setTextColor(TFT_WHITE);

  centerText(
    display3,
    "STUDY HELPER",
    35,
    2
  );

  centerText(
    display3,
    "READY",
    100,
    3
  );

  centerText(
    display3,
