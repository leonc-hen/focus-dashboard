// ============================================================
// TIMER SCREEN
// ============================================================

void drawTimer() {

  display1.fillScreen(TFT_BLACK);
  display2.fillScreen(TFT_BLACK);
  display3.fillScreen(TFT_BLACK);

  display1.setTextColor(TFT_WHITE);
  display2.setTextColor(TFT_WHITE);
  display3.setTextColor(TFT_WHITE);


  // DISPLAY 1

  centerText(
    display1,
    "STUDY",
    50,
    2
  );

  centerText(
    display1,
    "SESSION",
    105,
    2
  );


  // DISPLAY 2

  updateTimerValue();


  // DISPLAY 3

  updateTimerStatus();


  lastTimerDisplay = millis();
}


// ============================================================
// TIMER VALUE
// ============================================================

void updateTimerValue() {

  unsigned long minutes =
    elapsedSeconds / 60;

  unsigned long seconds =
    elapsedSeconds % 60;


  char timerText[10];

  sprintf(
    timerText,
    "%02lu:%02lu",
    minutes,
    seconds
  );


  display2.fillScreen(TFT_BLACK);

  display2.setTextColor(TFT_WHITE);

  centerText(
    display2,
    timerText,
    80,
    4
  );
}


// ============================================================
// TIMER STATUS
// ============================================================

void updateTimerStatus() {

  display3.fillScreen(TFT_BLACK);

  display3.setTextColor(TFT_WHITE);


  if (timerRunning) {

    centerText(
      display3,
      "RUNNING",
      55,
      2
    );

    centerText(
      display3,
      "SELECT",
      115,
      1
    );

    centerText(
      display3,
      "TO PAUSE",
      150,
      1
    );

  } else {

    centerText(
      display3,
      "PAUSED",
      55,
      2
    );

    centerText(
      display3,
      "SELECT",
      115,
      1
    );

    centerText(
      display3,
      "TO START",
      150,
      1
    );
  }
}


// ============================================================
// TIMER DISPLAY UPDATE
// ============================================================

void updateTimerDisplay() {

  updateTimerValue();

  updateTimerStatus();
}


