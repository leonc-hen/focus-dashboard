#define LGFX_USE_V1

#include <LovyanGFX.hpp>
#include <Wire.h>
#include <RTClib.h>

// ============================================================
// TFT DISPLAY CLASS
// ============================================================

class LGFX : public lgfx::LGFX_Device {

  lgfx::Panel_GC9A01 _panel_instance;
  lgfx::Bus_SPI _bus_instance;

public:

  LGFX(int8_t cs, int8_t dc, int8_t rst) {

    // --------------------------------------------------------
    // SPI BUS
    // --------------------------------------------------------

    {
      auto cfg = _bus_instance.config();

      cfg.spi_host = SPI2_HOST;
      cfg.freq_write = 40000000;

      cfg.pin_sclk = 12;
      cfg.pin_mosi = 11;
      cfg.pin_miso = -1;

      cfg.pin_dc = dc;

      _bus_instance.config(cfg);
      _panel_instance.setBus(&_bus_instance);
    }

    // --------------------------------------------------------
    // GC9A01 PANEL
    // --------------------------------------------------------

    {
      auto cfg = _panel_instance.config();

      cfg.pin_cs = cs;
      cfg.pin_rst = rst;
      cfg.pin_busy = -1;

      cfg.memory_width = 240;
      cfg.memory_height = 240;

      cfg.panel_width = 240;
      cfg.panel_height = 240;

      cfg.offset_x = 0;
      cfg.offset_y = 0;

      cfg.invert = true;
      cfg.rgb_order = false;
      cfg.dlen_16bit = false;

      cfg.bus_shared = true;

      _panel_instance.config(cfg);
    }

    setPanel(&_panel_instance);
  }
};


// ============================================================
// DISPLAYS
// ============================================================

LGFX display1(10, 5, 4);
LGFX display2(9, 6, 7);
LGFX display3(8, 13, 14);


// ============================================================
// RTC
// ============================================================

RTC_DS3231 rtc;


// ============================================================
// BUTTON PINS
// ============================================================

const int BUTTON_PREVIOUS = 15;
const int BUTTON_NEXT     = 16;
const int BUTTON_SELECT   = 1;
const int BUTTON_BACK     = 2;


// ============================================================
// BUTTON DEBOUNCE
// ============================================================

const unsigned long DEBOUNCE_TIME = 40;


// ============================================================
// BUTTON STRUCTURE
// ============================================================

struct Button {

  int pin;

  bool stableState;
  bool lastReading;

  unsigned long lastChangeTime;

  bool pressedEvent;
};


// ============================================================
// BUTTON OBJECTS
// ============================================================

Button previousButton = {
  BUTTON_PREVIOUS,
  HIGH,
  HIGH,
  0,
  false
};

Button nextButton = {
  BUTTON_NEXT,
  HIGH,
  HIGH,
  0,
  false
};

Button selectButton = {
  BUTTON_SELECT,
  HIGH,
  HIGH,
  0,
  false
};

Button backButton = {
  BUTTON_BACK,
  HIGH,
  HIGH,
  0,
  false
};


// ============================================================
// SCREEN STATES
// ============================================================

enum ScreenState {

  HOME,
  TASKS,
  TIMER,
  SETTINGS
};

ScreenState currentScreen = HOME;


// ============================================================
// DISPLAY REDRAW
// ============================================================

bool interfaceNeedsRedraw = true;


// ============================================================
// TIMER
// ============================================================

bool timerRunning = false;

unsigned long timerStartMillis = 0;
unsigned long elapsedSeconds = 0;


// ============================================================
// UPDATE TIMERS
// ============================================================

unsigned long lastClockUpdate = 0;
unsigned long lastTimerUpdate = 0;


// ============================================================
// CENTER TEXT
// ============================================================

void centerText(
  LGFX &display,
  const char* text,
  int y,
  int textSize
) {

  display.setTextSize(textSize);

  int textWidth = display.textWidth(text);

  int x = (240 - textWidth) / 2;

  display.setCursor(x, y);

  display.print(text);
}


// ============================================================
// INITIALIZE BUTTON
// ============================================================

void initializeButton(Button &button) {

  pinMode(button.pin, INPUT_PULLUP);

  bool state = digitalRead(button.pin);

  button.stableState = state;
  button.lastReading = state;

  button.lastChangeTime = millis();

  button.pressedEvent = false;
}


// ============================================================
// UPDATE BUTTON
// ============================================================

void updateButton(Button &button) {

  bool reading = digitalRead(button.pin);


  // ----------------------------------------------------------
  // Detect change
  // ----------------------------------------------------------

  if (reading != button.lastReading) {

    button.lastChangeTime = millis();

    button.lastReading = reading;
  }


  // ----------------------------------------------------------
  // Check whether signal has remained stable
  // ----------------------------------------------------------

  if (
    millis() - button.lastChangeTime >= DEBOUNCE_TIME
  ) {

    if (reading != button.stableState) {

      button.stableState = reading;


      // LOW = pressed

      if (button.stableState == LOW) {

        button.pressedEvent = true;
      }
    }
  }
}


// ============================================================
// CHECK BUTTON PRESS
// ============================================================

bool wasPressed(Button &button) {

  if (button.pressedEvent) {

    button.pressedEvent = false;

    return true;
  }

  return false;
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);


  // ----------------------------------------------------------
  // BUTTONS
  // ----------------------------------------------------------

  initializeButton(previousButton);
  initializeButton(nextButton);
  initializeButton(selectButton);
  initializeButton(backButton);


  // ----------------------------------------------------------
  // RTC
  // ----------------------------------------------------------

  Wire.begin(17, 18);

  if (!rtc.begin()) {

    Serial.println("RTC NOT FOUND");

  } else {

    Serial.println("RTC OK");

    if (rtc.lostPower()) {

      Serial.println("RTC lost power.");

      rtc.adjust(
        DateTime(F(__DATE__), F(__TIME__))
      );
    }
  }


  // ----------------------------------------------------------
  // DISPLAY 1
  // ----------------------------------------------------------

  display1.init();
  display1.setRotation(0);
  display1.fillScreen(TFT_BLACK);


  // ----------------------------------------------------------
  // DISPLAY 2
  // ----------------------------------------------------------

  display2.init();
  display2.setRotation(0);
  display2.fillScreen(TFT_BLACK);


  // ----------------------------------------------------------
  // DISPLAY 3
  // ----------------------------------------------------------

  display3.init();
  display3.setRotation(0);
  display3.fillScreen(TFT_BLACK);


  // ----------------------------------------------------------
  // INITIAL INTERFACE
  // ----------------------------------------------------------

  drawInterface();

  interfaceNeedsRedraw = false;

  lastClockUpdate = millis();
  lastTimerUpdate = millis();


  Serial.println();
  Serial.println("==============================");
  Serial.println("STUDY HELPER READY");
  Serial.println("==============================");
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  // ----------------------------------------------------------
  // UPDATE BUTTONS
  // ----------------------------------------------------------

  updateButton(previousButton);
  updateButton(nextButton);
  updateButton(selectButton);
  updateButton(backButton);


  // ----------------------------------------------------------
  // HANDLE BUTTONS
  // ----------------------------------------------------------

  handleButtons();


  // ----------------------------------------------------------
  // UPDATE TIMER
  // ----------------------------------------------------------

  updateTimer();


  // ----------------------------------------------------------
  // FULL REDRAW WHEN SCREEN CHANGES
  // ----------------------------------------------------------

  if (interfaceNeedsRedraw) {

    drawInterface();

    interfaceNeedsRedraw = false;

    lastClockUpdate = millis();
    lastTimerUpdate = millis();
  }


  // ----------------------------------------------------------
  // UPDATE CLOCK
  // ----------------------------------------------------------

  if (
    currentScreen == HOME &&
    millis() - lastClockUpdate >= 1000
  ) {

    lastClockUpdate = millis();

    updateHomeClock();
  }


  // ----------------------------------------------------------
  // UPDATE TIMER
  // ----------------------------------------------------------

  if (
    currentScreen == TIMER &&
    millis() - lastTimerUpdate >= 1000
  ) {

    lastTimerUpdate = millis();

    updateTimerDisplay();
  }
}


// ============================================================
// HANDLE BUTTONS
// ============================================================

void handleButtons() {

  if (wasPressed(previousButton)) {

    previousScreen();

    Serial.println("Button 1 -> PREVIOUS");
  }


  if (wasPressed(nextButton)) {

    nextScreen();

    Serial.println("Button 2 -> NEXT");
  }


  if (wasPressed(selectButton)) {

    selectCurrentScreen();

    Serial.println("Button 3 -> SELECT");
  }


  if (wasPressed(backButton)) {

    backAction();

    Serial.println("Button 4 -> BACK");
  }
}


// ============================================================
// NEXT SCREEN
// ============================================================

void nextScreen() {

  switch (currentScreen) {

    case HOME:
      currentScreen = TASKS;
      break;

    case TASKS:
      currentScreen = TIMER;
      break;

    case TIMER:
      currentScreen = SETTINGS;
      break;

    case SETTINGS:
      currentScreen = HOME;
      break;
  }

  interfaceNeedsRedraw = true;
}


// ============================================================
// PREVIOUS SCREEN
// ============================================================

void previousScreen() {

  switch (currentScreen) {

    case HOME:
      currentScreen = SETTINGS;
      break;

    case TASKS:
      currentScreen = HOME;
      break;

    case TIMER:
      currentScreen = TASKS;
      break;

    case SETTINGS:
      currentScreen = TIMER;
      break;
  }

  interfaceNeedsRedraw = true;
}


// ============================================================
// SELECT
// ============================================================

void selectCurrentScreen() {

  switch (currentScreen) {

    case HOME:

      Serial.println("Home selected");

      break;


    case TASKS:

      Serial.println("Task selected");

      break;


    case TIMER:

      if (!timerRunning) {

        timerRunning = true;

        timerStartMillis =
          millis() - (elapsedSeconds * 1000);

        Serial.println("Timer STARTED");

      } else {

        timerRunning = false;

        Serial.println("Timer PAUSED");
      }

      updateTimerDisplay();

      break;


    case SETTINGS:

      Serial.println("Settings selected");

      break;
  }
}


// ============================================================
// BACK
// ============================================================

void backAction() {

  switch (currentScreen) {

    case HOME:

      break;


    case TASKS:

      currentScreen = HOME;

      interfaceNeedsRedraw = true;

      break;


    case TIMER:

      timerRunning = false;

      elapsedSeconds = 0;

      Serial.println("Timer RESET");

      updateTimerDisplay();

      break;


    case SETTINGS:

      currentScreen = HOME;

      interfaceNeedsRedraw = true;

      break;
  }
}


// ============================================================
// TIMER LOGIC
// ============================================================

void updateTimer() {

  if (timerRunning) {

    elapsedSeconds =
      (millis() - timerStartMillis) / 1000;
  }
}


// ============================================================
// DRAW INTERFACE
// ============================================================

void drawInterface() {

  switch (currentScreen) {

    case HOME:
      drawHome();
      break;

    case TASKS:
      drawTasks();
      break;

    case TIMER:
      drawTimer();
      break;

    case SETTINGS:
      drawSettings();
      break;
  }
}


