// ============================================================
// TIMER
// ============================================================

void drawTimer() {

  display1.fillScreen(TFT_BLACK);
  display2.fillScreen(TFT_BLACK);
  display3.fillScreen(TFT_BLACK);

  display1.setTextColor(TFT_WHITE);
  display2.setTextColor(TFT_WHITE);
  display3.setTextColor(TFT_WHITE);


  // DISPLAY 1

  centerText(
    display1,
    "STUDY",
    40,
    2
  );

  centerText(
    display1,
    "SESSION",
    100,
    2
  );


  // DISPLAY 2

  unsigned long minutes =
    elapsedSeconds / 60;

  unsigned long seconds =
    elapsedSeconds % 60;


  char timerString[10];

  sprintf(
    timerString,
    "%02lu:%02lu",
    minutes,
    seconds
  );


  centerText(
    display2,
    timerString,
    85,
    4
  );


  drawTimerStatus();
}


// ============================================================
// TIMER STATUS
// ============================================================

void drawTimerStatus() {

  display3.setTextColor(TFT_WHITE);

  if (timerRunning) {

    centerText(
      display3,
      "RUNNING",
      60,
      2
    );

    centerText(
      display3,
      "SELECT",
      120,
      1
    );

    centerText(
      display3,
      "TO PAUSE",
      155,
      1
    );

  } else {

    centerText(
      display3,
      "PAUSED",
      60,
      2
    );

    centerText(
      display3,
      "SELECT",
      120,
      1
    );

    centerText(
      display3,
      "TO RESUME",
      155,
      1
    );
  }
}


// ============================================================
// UPDATE TIMER DISPLAY
// ============================================================

void updateTimerDisplay() {

  unsigned long minutes =
    elapsedSeconds / 60;

  unsigned long seconds =
    elapsedSeconds % 60;


  char timerString[10];

  sprintf(
    timerString,
    "%02lu:%02lu",
    minutes,
    seconds
  );


  display2.fillRect(
    0,
    75,
    240,
    55,
    TFT_BLACK
  );


  display2.setTextColor(TFT_WHITE);

  centerText(
    display2,
    timerString,
    85,
    4
  );


  display3.fillRect(
    0,
    45,
    240,
    130,
    TFT_BLACK
  );


  drawTimerStatus();
}


