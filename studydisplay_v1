    now.hour(),
    now.minute(),
    now.second()
  );


  centerText(
    display1,
    timeString,
    95,
    3
  );


  centerText(
    display1,
    "HOME",
    175,
    1
  );


  // DISPLAY 2

  display2.fillScreen(TFT_BLACK);
  display2.setTextColor(TFT_WHITE);

  centerText(
    display2,
    "TODAY",
    35,
    2
  );


  char dateString[11];

  sprintf(
    dateString,
    "%04d-%02d-%02d",
    now.year(),
    now.month(),
    now.day()
  );


  centerText(
    display2,
    dateString,
    95,
    2
  );


  centerText(
    display2,
    "NO TASKS YET",
    165,
    1
  );


  // DISPLAY 3

  display3.fillScreen(TFT_BLACK);
  display3.setTextColor(TFT_WHITE);

  centerText(
    display3,
    "STUDY TIMER",
    35,
    2
  );

  centerText(
    display3,
    "READY",
    100,
    3
  );

  centerText(
    display3,
    "SELECT TO START",
    170,
    1
  );
}


// ============================================================
// UPDATE HOME CLOCK
// ============================================================

void updateHomeClock() {

  DateTime now = rtc.now();

  char timeString[9];

  sprintf(
    timeString,
    "%02d:%02d:%02d",
    now.hour(),
    now.minute(),
    now.second()
  );


  display1.fillRect(
    0,
    90,
    240,
    45,
    TFT_BLACK
  );


  display1.setTextColor(TFT_WHITE);

  centerText(
    display1,
    timeString,
    95,
    3
  );
}


