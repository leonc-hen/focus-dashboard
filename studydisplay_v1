// ============================================================
// DISPLAY CLASS
// ============================================================

class LGFX : public lgfx::LGFX_Device {

  lgfx::Panel_GC9A01 panel;
  lgfx::Bus_SPI bus;

public:

  LGFX(int8_t cs, int8_t dc, int8_t rst) {

    // ----------------------------
    // SPI BUS
    // ----------------------------

    auto busConfig = bus.config();

    busConfig.spi_host = SPI2_HOST;
    busConfig.freq_write = 40000000;

    busConfig.pin_sclk = 12;
    busConfig.pin_mosi = 11;
    busConfig.pin_miso = -1;
    busConfig.pin_dc = dc;

    bus.config(busConfig);
    panel.setBus(&bus);


    // ----------------------------
    // DISPLAY PANEL
    // ----------------------------

    auto panelConfig = panel.config();

    panelConfig.pin_cs = cs;
    panelConfig.pin_rst = rst;
    panelConfig.pin_busy = -1;

    panelConfig.memory_width = 240;
    panelConfig.memory_height = 240;

    panelConfig.panel_width = 240;
    panelConfig.panel_height = 240;

    panelConfig.offset_x = 0;
    panelConfig.offset_y = 0;

    panelConfig.invert = true;
    panelConfig.rgb_order = false;
    panelConfig.dlen_16bit = false;

    panelConfig.bus_shared = true;

    panel.config(panelConfig);

    setPanel(&panel);
  }
};


// ============================================================
// DISPLAYS
// ============================================================

LGFX display1(10, 5, 4);
LGFX display2(9, 6, 7);
LGFX display3(8, 13, 14);


// ============================================================
// RTC
// ============================================================

RTC_DS3231 rtc;


// ============================================================
// BUTTON PINS
// ============================================================

const int BUTTON_PREVIOUS = 15;
const int BUTTON_NEXT     = 16;
const int BUTTON_SELECT   = 1;
const int BUTTON_BACK     = 2;


// ============================================================
// BUTTON DEBOUNCE
// ============================================================

const unsigned long DEBOUNCE_MS = 50;


// ============================================================
// BUTTON CLASS
// ============================================================

class DebouncedButton {

private:

  int pin;

  bool currentState;
  bool lastReading;

  unsigned long lastChangeTime;

public:

  DebouncedButton(int gpio) {

    pin = gpio;

    currentState = HIGH;
    lastReading = HIGH;

    lastChangeTime = 0;
  }


  void begin() {

    pinMode(pin, INPUT_PULLUP);

    currentState = digitalRead(pin);
    lastReading = currentState;

    lastChangeTime = millis();
  }


  bool pressed() {

    bool reading = digitalRead(pin);


    // --------------------------------
    // Raw signal changed
    // --------------------------------

    if (reading != lastReading) {

      lastReading = reading;

      lastChangeTime = millis();
    }


    // --------------------------------
    // Wait until stable
    // --------------------------------

    if (
      millis() - lastChangeTime >= DEBOUNCE_MS &&
      reading != currentState
    ) {

      currentState = reading;


      // LOW means button was pressed

      if (currentState == LOW) {

        return true;
      }
    }

    return false;
  }
};


// ============================================================
// BUTTON OBJECTS
// ============================================================

DebouncedButton buttonPrevious(BUTTON_PREVIOUS);
DebouncedButton buttonNext(BUTTON_NEXT);
DebouncedButton buttonSelect(BUTTON_SELECT);
DebouncedButton buttonBack(BUTTON_BACK);


// ============================================================
// SCREEN STATES
// ============================================================

enum Screen {

  HOME,
  TASKS,
  TIMER,
  SETTINGS
};

Screen currentScreen = HOME;


// ============================================================
// TIMER
// ============================================================

bool timerRunning = false;

unsigned long timerStartMillis = 0;
unsigned long elapsedSeconds = 0;

unsigned long lastTimerDisplay = 0;


// ============================================================
// CLOCK
// ============================================================

unsigned long lastClockDisplay = 0;


// ============================================================
// CENTER TEXT
// ============================================================

void centerText(
  LGFX &display,
  const char *text,
  int y,
  int size
) {

  display.setTextSize(size);

  int width = display.textWidth(text);

  int x = (240 - width) / 2;

  display.setCursor(x, y);

  display.print(text);
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);

  delay(200);


  // ==========================================================
  // BUTTONS
  // ==========================================================

  buttonPrevious.begin();
  buttonNext.begin();
  buttonSelect.begin();
  buttonBack.begin();


  // ==========================================================
  // RTC
  // ==========================================================

  Wire.begin(17, 18);

  if (!rtc.begin()) {

    Serial.println("RTC NOT FOUND");

  } else {

    Serial.println("RTC CONNECTED");

    if (rtc.lostPower()) {

      Serial.println("RTC LOST POWER");

      rtc.adjust(
        DateTime(F(__DATE__), F(__TIME__))
      );
    }
  }


  // ==========================================================
  // DISPLAY 1
  // ==========================================================

  display1.init();
  display1.setRotation(0);
  display1.fillScreen(TFT_BLACK);


  // ==========================================================
  // DISPLAY 2
  // ==========================================================

  display2.init();
  display2.setRotation(0);
  display2.fillScreen(TFT_BLACK);


  // ==========================================================
  // DISPLAY 3
  // ==========================================================

  display3.init();
  display3.setRotation(0);
  display3.fillScreen(TFT_BLACK);


  // ==========================================================
  // DRAW HOME
  // ==========================================================

  drawHome();


  Serial.println();
  Serial.println("==============================");
  Serial.println("STUDY HELPER READY");
  Serial.println("==============================");
  Serial.println("Button 1 = Previous");
  Serial.println("Button 2 = Next");
  Serial.println("Button 3 = Select");
  Serial.println("Button 4 = Back");
}


// ============================================================
// LOOP
// ============================================================

void loop() {

  // ==========================================================
  // BUTTONS
  // ==========================================================

  if (buttonPrevious.pressed()) {

    Serial.println("BUTTON 1: PREVIOUS");

    goPrevious();
  }


  if (buttonNext.pressed()) {

    Serial.println("BUTTON 2: NEXT");

    goNext();
  }


  if (buttonSelect.pressed()) {

    Serial.println("BUTTON 3: SELECT");

    selectAction();
  }


  if (buttonBack.pressed()) {

    Serial.println("BUTTON 4: BACK");

    backAction();
  }


  // ==========================================================
  // TIMER
  // ==========================================================

  updateTimer();


  // ==========================================================
  // CLOCK
  // ==========================================================

  if (
    currentScreen == HOME &&
    millis() - lastClockDisplay >= 1000
  ) {

    lastClockDisplay = millis();

    updateHomeTime();
  }


  // ==========================================================
  // TIMER DISPLAY
  // ==========================================================

  if (
    currentScreen == TIMER &&
    millis() - lastTimerDisplay >= 1000
  ) {

    lastTimerDisplay = millis();

    updateTimerDisplay();
  }
}


// ============================================================
// NEXT SCREEN
// ============================================================

void goNext() {

  switch (currentScreen) {

    case HOME:

      currentScreen = TASKS;

      drawTasks();

      break;


    case TASKS:

      currentScreen = TIMER;

      drawTimer();

      break;


    case TIMER:

      currentScreen = SETTINGS;

      drawSettings();

      break;


    case SETTINGS:

      currentScreen = HOME;

      drawHome();

      break;
  }
}


// ============================================================
// PREVIOUS SCREEN
// ============================================================

void goPrevious() {

  switch (currentScreen) {

    case HOME:

      currentScreen = SETTINGS;

      drawSettings();

      break;


    case TASKS:

      currentScreen = HOME;

      drawHome();

      break;


    case TIMER:

      currentScreen = TASKS;

      drawTasks();

      break;


    case SETTINGS:

      currentScreen = TIMER;

      drawTimer();

      break;
  }
}


// ============================================================
// SELECT ACTION
// ============================================================

void selectAction() {

  switch (currentScreen) {

    // --------------------------------------------------------
    // HOME
    // --------------------------------------------------------

    case HOME:

      Serial.println("Home selected");

      break;


    // --------------------------------------------------------
    // TASKS
    // --------------------------------------------------------

    case TASKS:

      Serial.println("Task selected");

      currentScreen = TIMER;

      drawTimer();

      break;


    // --------------------------------------------------------
    // TIMER
    // --------------------------------------------------------

    case TIMER:

      if (timerRunning) {

        // Pause

        timerRunning = false;

        elapsedSeconds =
          (millis() - timerStartMillis) / 1000;

        Serial.println("TIMER PAUSED");

      } else {

        // Start / resume

        timerStartMillis =
          millis() - (elapsedSeconds * 1000);

        timerRunning = true;

        Serial.println("TIMER STARTED");
      }

      drawTimer();

      break;


    // --------------------------------------------------------
    // SETTINGS
    // --------------------------------------------------------

    case SETTINGS:

      Serial.println("Settings selected");

      break;
  }
}


// ============================================================
// BACK ACTION
// ============================================================

void backAction() {

  switch (currentScreen) {

    // --------------------------------------------------------
    // HOME
    // --------------------------------------------------------

    case HOME:

      break;


    // --------------------------------------------------------
    // TASKS
    // --------------------------------------------------------

    case TASKS:

      currentScreen = HOME;

      drawHome();

      break;


    // --------------------------------------------------------
    // TIMER
    // --------------------------------------------------------

    case TIMER:

      timerRunning = false;

      elapsedSeconds = 0;

      Serial.println("TIMER RESET");

      drawTimer();

      break;


    // --------------------------------------------------------
    // SETTINGS
    // --------------------------------------------------------

    case SETTINGS:

      currentScreen = HOME;

      drawHome();

      break;
  }
}


// ============================================================
// TIMER UPDATE
// ============================================================

void updateTimer() {

  if (!timerRunning) {

    return;
  }


  elapsedSeconds =
    (millis() - timerStartMillis) / 1000;
}


