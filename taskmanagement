  DateTime now = rtc.now();

  display1.fillScreen(TFT_BLACK);
  display1.setTextColor(TFT_WHITE);

  centerText(
    display1,
    "TIME",
    35,
    2
  );

  char timeText[9];

  sprintf(
    timeText,
    "%02d:%02d:%02d",
    now.hour(),
    now.minute(),
    now.second()
  );

  centerText(
    display1,
    timeText,
    95,
    3
  );

  centerText(
    display1,
    "HOME",
    180,
    1
  );

  display2.fillScreen(TFT_BLACK);
  display2.setTextColor(TFT_WHITE);

  centerText(
    display2,
    "NEXT TASK",
    35,
    2
  );

  centerText(
    display2,
    tasks[selectedTask].name,
    95,
    3
  );

  centerText(
    display2,
    "SELECT FOR TASKS",
    170,
    1
  );

  display3.fillScreen(TFT_BLACK);
  display3.setTextColor(TFT_WHITE);

  centerText(
    display3,
    "STUDY HELPER",
    35,
    2
  );

  centerText(
    display3,
    "READY",
    100,
    3
  );

  centerText(
    display3,
    "BUTTON 3 = SELECT",
    170,
    1
  );
}


// ============================================================
// UPDATE HOME TIME
// ============================================================

void updateHomeTime() {

  DateTime now = rtc.now();

  display1.fillRect(
    0,
    85,
    240,
    60,
    TFT_BLACK
  );

  char timeText[9];

  sprintf(
    timeText,
    "%02d:%02d:%02d",
    now.hour(),
    now.minute(),
    now.second()
  );

  display1.setTextColor(TFT_WHITE);

  centerText(
    display1,
    timeText,
    95,
    3
  );
}


// ============================================================
// TASK SCREEN
// ============================================================

void drawTasks() {

  display1.fillScreen(TFT_BLACK);
  display2.fillScreen(TFT_BLACK);
  display3.fillScreen(TFT_BLACK);

  display1.setTextColor(TFT_WHITE);
  display2.setTextColor(TFT_WHITE);
  display3.setTextColor(TFT_WHITE);

  centerText(
    display1,
    "TASKS",
    25,
    2
  );

  centerText(
    display1,
    tasks[selectedTask].name,
    85,
    3
  );

  char positionText[10];

  sprintf(
    positionText,
    "%d / %d",
    selectedTask + 1,
    NUM_TASKS
  );

  centerText(
    display1,
    positionText,
    145,
    2
  );

  centerText(
    display1,
    "SELECT",
    190,
    1
  );

  centerText(
    display2,
    "AVAILABLE",
    15,
    2
  );

  for (int i = 0; i < NUM_TASKS; i++) {

    char line[30];

    if (i == selectedTask) {

      sprintf(
        line,
        "> %s",
        tasks[i].name
      );

    } else {

      sprintf(
        line,
        "  %s",
        tasks[i].name
      );
    }

    display2.setTextSize(1);

    int width =
      display2.textWidth(line);

    int x =
      (240 - width) / 2;

    display2.setCursor(
      x,
      45 + i * 30
    );

    display2.print(line);
  }

  centerText(
    display3,
    "BUTTON 1",
    30,
    1
  );

  centerText(
    display3,
    "PREVIOUS",
    55,
    1
  );

  centerText(
    display3,
    "BUTTON 2",
    90,
    1
  );

  centerText(
    display3,
    "NEXT",
    115,
    1
  );

  centerText(
    display3,
    "BUTTON 3 = SELECT",
    160,
    1
  );

  centerText(
    display3,
    "BUTTON 4 = BACK",
    190,
    1
  );
}


// ============================================================
// TIMER SCREEN
// ============================================================

void drawTimer() {

  display1.fillScreen(TFT_BLACK);
  display2.fillScreen(TFT_BLACK);
  display3.fillScreen(TFT_BLACK);

  display1.setTextColor(TFT_WHITE);
  display2.setTextColor(TFT_WHITE);
  display3.setTextColor(TFT_WHITE);

  centerText(
    display1,
    "STUDY TIMER",
    30,
    2
  );

  centerText(
    display1,
    tasks[activeTask].name,
    90,
    3
  );

  if (timerRunning) {

    centerText(
      display1,
      "RUNNING",
      155,
      1
    );

  } else if (remainingSeconds == 0) {

    centerText(
      display1,
      "COMPLETE",
      155,
      1
    );

  } else {

    centerText(
      display1,
      "READY",
      155,
      1
    );
  }

  updateTimerValue();
  updateTimerStatus();

  lastTimerDisplay = millis();
}


// ============================================================
// TIMER VALUE
// ============================================================

void updateTimerValue() {

  unsigned long minutes =
    remainingSeconds / 60;

  unsigned long seconds =
    remainingSeconds % 60;

  char timerText[10];

  sprintf(
    timerText,
    "%02lu:%02lu",
    minutes,
    seconds
  );

  display2.fillScreen(TFT_BLACK);
  display2.setTextColor(TFT_WHITE);

  centerText(
    display2,
    timerText,
    75,
    4
  );

  char durationText[20];

  sprintf(
    durationText,
    "%d MIN",
    durations[selectedDuration]
  );

  centerText(
    display2,
    durationText,
    145,
    2
  );
}


// ============================================================
// TIMER STATUS
// ============================================================

void updateTimerStatus() {

  display3.fillScreen(TFT_BLACK);
  display3.setTextColor(TFT_WHITE);

  if (timerRunning) {

    centerText(
      display3,
      "RUNNING",
      40,
      2
    );

    centerText(
      display3,
      "SELECT",
      90,
      1
    );

    centerText(
      display3,
      "PAUSE / RESUME",
      115,
      1
    );

    centerText(
      display3,
      "BACK = TASKS",
      165,
      1
    );

    return;
  }

  if (remainingSeconds == 0) {

    centerText(
      display3,
      "COMPLETE!",
      45,
      2
    );

    centerText(
      display3,
      "SELECT = RESTART",
      105,
      1
    );

    centerText(
      display3,
      "BACK = TASKS",
      160,
      1
    );

    return;
  }

  centerText(
    display3,
    "READY / PAUSED",
    40,
    2
  );

  centerText(
    display3,
    "SELECT = START",
    95,
    1
  );

  centerText(
    display3,
    "1 / 2 = CHANGE",
    130,
    1
  );

  centerText(
    display3,
    "BACK = TASKS",
    175,
    1
  );
}


// ============================================================
// TIMER DISPLAY UPDATE
// ============================================================

void updateTimerDisplay() {

  updateTimer();
  updateTimerValue();
  updateTimerStatus();
}
